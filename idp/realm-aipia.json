{
  "realm": "aipia",
  "enabled": true,
  "displayName": "AIPIA",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 5184000,
  "_comment": "패밀리 공용 사용자 풀. 소셜(Identity Providers)은 README 가이드대로 어드민 UI 에서 추가(secret 필요). 아래 clients 는 패밀리 앱 예시 2개 — public + PKCE(S256).",
  "clients": [
    {
      "clientId": "aipia-app",
      "name": "AIPIA (홈/앱)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "kr.co.aipia.app://oauth/*",
        "https://aipia.co.kr/*",
        "http://localhost:8100/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "aipia-novel-app",
      "name": "AIPIA Novel (앱)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "kr.co.aipia.app://oauth/*",
        "https://novel.aipia.co.kr/*",
        "http://localhost:8100/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "aipia-game-app",
      "name": "AIPIA Game (앱)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "kr.co.aipia.game://oauth/*",
        "https://game.aipia.co.kr/*",
        "http://localhost:8100/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    }
  ]
}
