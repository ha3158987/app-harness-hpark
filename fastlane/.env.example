# fastlane 환경변수 템플릿. 복사해서 fastlane/.env 로 채우세요.
#   cp fastlane/.env.example fastlane/.env
# .env 는 .gitignore 로 절대 커밋되지 않습니다. 실제 키/비번을 여기(.example)에 적지 마세요.

# ── iOS / App Store Connect ──
FASTLANE_APPLE_ID=you@example.com
FASTLANE_ITC_TEAM_ID=
FASTLANE_DEV_TEAM_ID=

# match (인증서/프로비저닝 암호화 저장소)
MATCH_GIT_URL=git@github.com:yourorg/ios-certificates.git
MATCH_PASSWORD=

# App Store Connect API 키(권장: Apple ID 2FA 회피). 키 파일 경로/ID.
# APP_STORE_CONNECT_API_KEY_PATH=
# APP_STORE_CONNECT_API_KEY_ID=
# APP_STORE_CONNECT_API_ISSUER_ID=

# ── Android / Play Console ──
# Play Console 서비스 계정 JSON 파일 경로 (저장소 밖, 절대 커밋 금지)
SUPPLY_JSON_KEY_FILE=/absolute/path/to/play-service-account.json

# ── 마케팅 SDK 키 (generate-app 이 네이티브 번들에만 베이크; 레포 커밋 금지) ──
# AppsFlyer (어트리뷰션). 슬러그별로 다르면 APPSFLYER_DEV_KEY_<SLUG대문자_언더스코어> 사용.
# APPSFLYER_DEV_KEY=
# APPSFLYER_IOS_APP_ID=

# ── Android 릴리즈 서명 (gradle 에 주입; keystore 는 저장소 밖에 둘 것) ──
# 보통 build/<slug>/android/keystore.properties 또는 ~/.gradle/gradle.properties 로 주입 권장.
# ANDROID_KEYSTORE_PATH=/absolute/path/to/release.keystore
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
