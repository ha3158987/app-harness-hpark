# fastlane 환경변수 템플릿. 복사해서 fastlane/.env 로 채우세요.
#   cp fastlane/.env.example fastlane/.env
# .env 는 .gitignore 로 절대 커밋되지 않습니다. 실제 키/비번을 여기(.example)에 적지 마세요.
#
# 전체 자격증명 관리 가이드(어떤 키가 왜 필요한지, 로컬↔CI 매핑)는 → docs/09-CREDENTIALS.md
# 바이너리 키 파일(.p8/.jks/JSON)은 레포의 secrets/ 폴더에 두세요(gitignore됨). → secrets/README.md

# ── iOS / Apple 계정 (조직 공유) ──
FASTLANE_APPLE_ID=you@example.com
FASTLANE_ITC_TEAM_ID=
FASTLANE_DEV_TEAM_ID=                      # Apple Developer 팀 ID (예: 3W889GYPRK)

# ── iOS / App Store Connect API 키 (조직 공유, TestFlight 업로드용) ──
# 키 파일은 secrets/asc_api_key.p8 에 두기. 아래 3개는 Fastfile 이 읽는 변수명과 일치해야 함.
#   (.p8 "내용"을 직접 주입하는 CI 와 달리, 로컬은 _KEY 에 파일경로 또는 내용 사용)
APP_STORE_CONNECT_API_KEY_KEY_ID=          # ASC 키 ID (10자리)  · CI Secret: ASC_KEY_ID
APP_STORE_CONNECT_API_KEY_ISSUER_ID=       # ASC Issuer ID (UUID) · CI Secret: ASC_ISSUER_ID
APP_STORE_CONNECT_API_KEY_KEY=             # .p8 내용 또는 경로     · CI Secret: ASC_KEY_P8

# ── iOS / fastlane match (인증서·프로비저닝 암호화 저장소, 조직 공유) ──
MATCH_GIT_URL=git@github.com:aipia-team/ios-certificates.git
MATCH_PASSWORD=                            # match 복호화 비번
# MATCH_GIT_BASIC_AUTHORIZATION=           # CI 전용: base64("user:PAT"). 로컬은 git 권한으로 충분.

# ── Android / Play Console 서비스계정 (조직 공유, 업로드 인증) ──
# 로컬: 파일 경로(SUPPLY_JSON_KEY_FILE) / CI: 내용(PLAY_SERVICE_ACCOUNT_JSON) — 둘 다 fastlane supply 가 지원.
SUPPLY_JSON_KEY_FILE=secrets/play-service-account.json

# ── Android / Firebase App Distribution (내부 테스터 즉시 배포 — TestFlight 대응) ──
# 자격증명 키 파일은 **없다** — 조직 정책상 서비스계정 키를 만들 수 없다.
#   로컬: gcloud auth application-default login --project=<firebase 프로젝트 id>
#   CI  : GitHub OIDC(WIF). 레포 변수 FIREBASE_WIF_PROVIDER_<SLUG> / FIREBASE_WIF_SERVICE_ACCOUNT_<SLUG>
# (예외적으로 키 파일을 쓸 수 있게 되면 아래로 경로 지정 가능)
# FIREBASE_SERVICE_CREDENTIALS_FILE=
# 배포 대상 테스터 그룹 별칭(Firebase 콘솔에서 미리 생성). 쉼표로 여러 개.
FIREBASE_TESTER_GROUPS=aipia_internal

# ── Android / 릴리즈 서명 keystore (조직 공유 업로드 키 = aipia 1개) ──
# keystore 파일은 secrets/android/upload.jks 에 두기. gradle 은 build/<slug>/android/keystore.properties 로 주입.
ANDROID_KEYSTORE_PATH=secrets/android/upload.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# ── 마케팅 SDK 키 (generate-app 이 네이티브 번들에만 베이크; 레포 커밋 금지) ──
# AppsFlyer (어트리뷰션). 슬러그별로 다르면 APPSFLYER_DEV_KEY_<SLUG대문자_언더스코어> 사용.
# APPSFLYER_DEV_KEY=
# APPSFLYER_IOS_APP_ID=
