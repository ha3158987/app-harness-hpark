# Fastfile — 멀티앱 하네스용 빌드/업로드 lane.
#
# 모든 lane 은 slug 파라미터를 받아 build/<slug> 프로젝트를 대상으로 한다.
#   bundle exec fastlane android beta slug:service-a       # Play 내부/베타 트랙
#   bundle exec fastlane android firebase slug:service-a    # Firebase App Distribution
#   bundle exec fastlane ios beta slug:service-a            # TestFlight
#
# 안전 원칙 (README/STRATEGY):
#  - 자격증명은 여기 평문으로 두지 않는다. fastlane match / 환경변수(.env)로만.
#  - 자동화 범위 = 내부 테스터까지(TestFlight · Play 내부/베타 · Firebase App Distribution).
#    프로덕션 공개는 사람이 콘솔에서.

require 'json'
require 'fileutils'

# fastlane 은 플러그인을 **Gemfile 을 통해서만** 자동 로드한다 — `PluginManager#available_gems`
# 가 `Bundler::SharedHelpers.default_gemfile` 을 읽고, 없으면 빈 배열을 돌려준다. 이 레포는
# 번들러를 쓰지 않고 `gem install fastlane` 로 도는 구조라 Gemfile 이 없고, 그래서
# fastlane/Pluginfile 에 적어둬도 로드되지 않는다("Could not find action 'firebase_app_distribution'").
# → 여기서 직접 require 한다. gem 이 없는 환경에서도 다른 lane(ios beta / android beta)은
#   돌아야 하므로 삼키고, 실제로 필요한 lane 에서만 아래 require_firebase_plugin! 로 끊는다.
begin
  require 'fastlane/plugin/firebase_app_distribution'
rescue LoadError
  nil
end

def require_firebase_plugin!
  return if defined?(Fastlane::Actions::FirebaseAppDistributionAction)
  UI.user_error!(
    "fastlane-plugin-firebase_app_distribution (>= 1.0.0) 이 설치돼 있지 않습니다.\n" \
    "  gem install fastlane-plugin-firebase_app_distribution --version '>= 1.0.0'\n" \
    "(1.0.0 미만은 WIF external_account 자격증명을 못 가른다 — fastlane/Pluginfile 참고)"
  )
end

REPO_ROOT = File.expand_path('..', __dir__)

def app_config(slug)
  path = File.join(REPO_ROOT, 'apps', slug, 'app.config.json')
  UI.user_error!("apps/#{slug}/app.config.json 없음") unless File.exist?(path)
  JSON.parse(File.read(path))
end

def build_dir(slug)
  dir = File.join(REPO_ROOT, 'build', slug)
  UI.user_error!("build/#{slug} 없음 — generate-app 먼저 실행하세요") unless Dir.exist?(dir)
  dir
end

def require_slug(options)
  slug = options[:slug]
  UI.user_error!('slug 파라미터 필요: fastlane <lane> slug:<slug>') if slug.nil? || slug.empty?
  slug
end

def release_artifact_stem(slug)
  version = app_config(slug).fetch('version')
  "#{slug}-v#{version.fetch('name')}-#{version.fetch('code')}"
end

def android_artifact_path(slug, extension)
  File.join(build_dir(slug), 'android', 'artifacts', "#{release_artifact_stem(slug)}.#{extension}")
end

def ios_artifact_path(slug)
  File.join(build_dir(slug), 'ios', 'output', "#{release_artifact_stem(slug)}.ipa")
end

def stage_android_artifact(slug, kind, extension)
  source = File.join(build_dir(slug), 'android', 'app', 'build', 'outputs', kind, 'release', "app-release.#{extension}")
  UI.user_error!("빌드 산출물 없음: #{source}") unless File.file?(source)
  destination = android_artifact_path(slug, extension)
  FileUtils.mkdir_p(File.dirname(destination))
  FileUtils.cp(source, destination)
  UI.message("Android 산출물: #{destination}")
  destination
end

# Firebase App Distribution 이 요구하는 앱 식별자는 번들 id(appId)가 아니라
# **Firebase 앱 ID**(`1:123456789012:android:abc…`) 다. 이 값은 CI 가 이미 시크릿에서
# 배치하는 google-services.json 안에 들어 있으므로, app.config.json 에 키를 새로 만들지 않고
# 거기서 꺼내 쓴다 — 앱이 늘어도 사람이 관리할 값이 늘지 않는다.
#
# 한 Firebase 프로젝트에 여러 앱(dev/prod)이 등록돼 있으면 client 배열에 여럿이 들어온다.
# 반드시 **package_name 이 이 앱의 appId 와 같은 항목**을 골라야 한다 — 첫 항목을 집으면
# 조용히 다른 앱으로 배포된다.
def firebase_android_app_id(slug)
  app_id = app_config(slug)['appId']
  path = File.join(build_dir(slug), 'android', 'app', 'google-services.json')
  unless File.exist?(path)
    UI.user_error!(
      "google-services.json 없음: #{path}\n" \
      "Firebase App Distribution 은 Firebase 에 등록된 앱만 배포할 수 있습니다.\n" \
      "  · CI  — GOOGLE_SERVICES_B64_<SLUG> 시크릿을 등록하세요 (docs/08-DEPLOY.md §4)\n" \
      "  · 로컬 — Firebase 콘솔에서 받아 위 경로에 두세요"
    )
  end
  clients = JSON.parse(File.read(path))['client'] || []
  hit = clients.find { |c| c.dig('client_info', 'android_client_info', 'package_name') == app_id }
  unless hit
    known = clients.map { |c| c.dig('client_info', 'android_client_info', 'package_name') }.compact
    UI.user_error!(
      "google-services.json 에 패키지 #{app_id} 항목이 없습니다 (있는 것: #{known.join(', ')}).\n" \
      "다른 앱의 google-services.json 이 주입됐을 수 있습니다 — 시크릿 이름의 슬러그를 확인하세요."
    )
  end
  hit.dig('client_info', 'mobilesdk_app_id') ||
    UI.user_error!("google-services.json 에 mobilesdk_app_id 가 없습니다: #{path}")
end

# 알림에 캐릭터 프로필 사진을 붙이는 Notification Service Extension 의 타깃명.
# generate-app.mjs 의 NSE_NAME 과 **같은 값이어야 한다** — 다르면 서명 대상이 안 잡혀
# archive 가 실패한다.
IOS_NSE_TARGET = 'NotificationService'

# match 의 만료 인증서 자동 갱신(renew_expired_certs)이 **CLI 옵션으로 복원된** 버전.
# 2.220 에 들어왔다가 비활성화됐고(2.236 까지는 runner 안에서 false 고정이라 옵션 자체가
# 없다), 2.237 에서 opt-in 으로 되돌아왔다. 이보다 낮은 fastlane 에 이 키를 넘기면
# "Could not find option" 으로 lane 이 통째로 죽으므로, 넘기기 전에 버전을 본다.
MATCH_RENEW_MIN_VERSION = '2.237.0'

# 확장은 **별개 번들 id** 를 갖고, 따라서 **별개 프로비저닝 프로파일**이 필요하다.
# 이걸 빼면 릴리즈가 두 군데서 깨진다:
#   1. archive — 확장 타깃이 자동서명에 남아 수동서명 앱과 섞인다
#   2. export  — provisioningProfiles 맵에 확장 항목이 없다
def ios_ext_app_id(app_id)
  "#{app_id}.#{IOS_NSE_TARGET}"
end

# 이 빌드에 확장이 실제로 들어있는지 — 프로젝트에 **app-extension 타깃**이 있는지로
# 판단한다. push/firebase 를 끈 앱은 확장이 없고, 그때 확장 프로파일을 요구하면
# match 가 없는 프로파일을 찾다 CI 를 멈춘다.
#
# `.appex` 문자열 포함만으로 보면 안 된다 — 주석·다른 타깃의 참조에도 그 문자열이
# 나올 수 있어 확장이 없는데 있다고 오판할 수 있다. 네이티브 타깃 선언에 이름과
# app-extension productType 이 함께 있는지를 본다.
def ios_has_nse?(build_path)
  pbx = File.join(build_path, 'ios', 'App', 'App.xcodeproj', 'project.pbxproj')
  return false unless File.exist?(pbx)
  txt = File.read(pbx)
  txt.match?(/name = #{Regexp.escape(IOS_NSE_TARGET)};[^}]*productType = "com\.apple\.product-type\.app-extension"/m) ||
    txt.match?(/productType = "com\.apple\.product-type\.app-extension";[^}]*name = #{Regexp.escape(IOS_NSE_TARGET)};/m)
end

# ──────────────────────────── iOS ────────────────────────────
platform :ios do
  # App Store Connect API 키(Apple ID 2FA 회피). CI 는 env(APP_STORE_CONNECT_API_KEY_KEY)로 주입.
  # 로컬은 .env 의 키 본문이 비어 있으면 secrets/asc_api_key.p8 "내용"으로 폴백한다.
  # ⚠️ key_filepath 로 넘기면 이 fastlane/OpenSSL 조합에서 'invalid curve name' 으로 깨진다 —
  #    반드시 파일을 읽어 key_content 로 넘긴다(검증된 경로). CI 는 env 경로라 무관.
  before_all do
    key_id      = ENV['APP_STORE_CONNECT_API_KEY_KEY_ID']
    key_content = ENV['APP_STORE_CONNECT_API_KEY_KEY']
    local_p8    = File.join(REPO_ROOT, 'secrets', 'asc_api_key.p8')
    key_content = File.read(local_p8) if (key_content.nil? || key_content.strip.empty?) && File.exist?(local_p8)
    if key_id && !key_id.to_s.strip.empty? && key_content && !key_content.strip.empty?
      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: ENV['APP_STORE_CONNECT_API_KEY_ISSUER_ID'],
        key_content: key_content,
        in_house: false
      )
    end
  end

  desc 'iOS 아카이브(.ipa) 빌드. 서명은 match 로.'
  lane :build do |options|
    slug = require_slug(options)
    cfg = app_config(slug)
    app_id = cfg['appId']
    build_path = build_dir(slug)
    workspace = File.join(build_path, 'ios', 'App', 'App.xcworkspace')
    project = File.join(build_path, 'ios', 'App', 'App.xcodeproj')

    # 알림 확장(Notification Service Extension)은 별개 번들 id → 별개 프로파일.
    has_nse = ios_has_nse?(build_path)
    ext_id = ios_ext_app_id(app_id)
    identifiers = has_nse ? [app_id, ext_id] : app_id

    # 인증서/프로비저닝: 암호화 git repo(match)에서 가져온다. 읽기전용으로.
    # ⚠️ 확장 프로파일이 match repo 에 아직 없으면 여기서 실패한다 — 그때는 로컬에서
    #    `fastlane ios regen_profile slug:<slug>` 를 1회 돌려 만들어야 한다(그 lane 도
    #    확장 id 를 같이 생성한다).
    match(type: 'appstore', app_identifier: identifiers, readonly: true)

    # Capacitor 기본 프로젝트는 자동서명(팀 미지정) → CI archive 실패.
    # match 로 받은 프로파일로 수동서명 전환. team/profile 은 match 가 ENV 로 노출한 값 사용.
    profile_name = ENV["sigh_#{app_id}_appstore_profile-name"] || "match AppStore #{app_id}"
    team_id = ENV["sigh_#{app_id}_appstore_team-id"] || ENV['FASTLANE_DEV_TEAM_ID']
    update_code_signing_settings(
      use_automatic_signing: false,
      path: project,
      team_id: team_id,
      code_sign_identity: 'Apple Distribution',
      bundle_identifier: app_id,
      profile_name: profile_name,
      targets: ['App']
    )

    profiles = { app_id => profile_name }
    if has_nse
      # match 가 확장 프로파일을 실제로 가져왔는지 **여기서 확인한다.** 안 하면
      # 프로파일 이름을 추측한 채로 진행해, 한참 뒤 export 단계에서 맥락 없는
      # "No profile for team … matching … found" 로 실패한다. 원인(확장 프로파일이
      # match repo 에 없음)과 조치(regen_profile 1회 실행)가 로그에 안 남는다.
      unless ENV["sigh_#{ext_id}_appstore"]
        UI.user_error!(
          "알림 확장(#{ext_id})의 appstore 프로비저닝 프로파일이 match 에 없습니다.\n" \
          "CI 의 match 는 readonly 라 스스로 만들 수 없습니다. 로컬에서 1회 실행하세요:\n" \
          "  /opt/homebrew/bin/fastlane ios regen_profile slug:#{slug}\n" \
          "그 뒤 CI(release)를 iOS 로 재실행하면 됩니다."
        )
      end
      # 확장도 같은 방식으로 수동서명 전환. 타깃별로 따로 호출하는 이유: 번들 id 와
      # 프로파일이 앱과 다르므로 한 번의 호출로는 둘 다 설정할 수 없다.
      ext_profile = ENV["sigh_#{ext_id}_appstore_profile-name"] || "match AppStore #{ext_id}"
      update_code_signing_settings(
        use_automatic_signing: false,
        path: project,
        team_id: team_id,
        code_sign_identity: 'Apple Distribution',
        bundle_identifier: ext_id,
        profile_name: ext_profile,
        targets: [IOS_NSE_TARGET]
      )
      profiles[ext_id] = ext_profile
      UI.message("알림 확장 서명 배선: #{ext_id} ← #{ext_profile}")
    end

    build_app(
      workspace: workspace,
      scheme: 'App',
      export_method: 'app-store',
      output_directory: File.join(build_path, 'ios', 'output'),
      output_name: File.basename(ios_artifact_path(slug)),
      clean: true,
      export_options: {
        signingStyle: 'manual',
        provisioningProfiles: profiles
      }
    )
  end

  desc 'TestFlight 업로드 (베타). 프로덕션 공개 아님.'
  lane :beta do |options|
    slug = require_slug(options)
    build(options) unless options[:skip_build]
    upload_to_testflight(
      ipa: ios_artifact_path(slug),
      skip_waiting_for_build_processing: true,
      distribute_external: false # 내부 테스터까지만. 외부 배포/심사 제출은 사람이.
    )
    UI.success("TestFlight 업로드 완료 (#{slug}). 외부 배포/심사 제출은 App Store Connect 에서 직접.")
  end

  desc 'iOS Firebase App Distribution — 등록된 기기용 Ad Hoc IPA로 재서명하여 배포'
  lane :firebase do |options|
    require_firebase_plugin!
    slug = require_slug(options)
    cfg = app_config(slug)
    app_id = cfg['appId']
    build_path = build_dir(slug)
    plist = File.join(build_path, 'ios', 'App', 'GoogleService-Info.plist')
    UI.user_error!("Firebase 설정 없음: #{plist}") unless File.exist?(plist)
    firebase_bundle = get_info_plist_value(path: plist, key: 'BUNDLE_ID')
    firebase_id = get_info_plist_value(path: plist, key: 'GOOGLE_APP_ID')
    UI.user_error!('Firebase BUNDLE_ID가 대상 앱과 다릅니다') unless firebase_bundle == app_id
    UI.user_error!('Firebase iOS 앱 ID가 없습니다') unless firebase_id.to_s.match?(/\A1:\d+:ios:[a-zA-Z0-9]+\z/)

    build(options) unless options[:skip_build]
    source = ios_artifact_path(slug)
    UI.user_error!("IPA 없음: #{source}") unless File.exist?(source)
    UI.user_error!('IPA 번들 ID가 대상 앱과 다릅니다') unless get_ipa_info_plist_value(ipa: source, key: 'CFBundleIdentifier') == app_id

    identifiers = [app_id]
    identifiers << ios_ext_app_id(app_id) if ios_has_nse?(build_path)
    # 기기 추가 후 로컬 regen_profile profile_type:adhoc 실행. CI는 저장된 프로파일만 사용.
    match(type: 'adhoc', app_identifier: identifiers, readonly: true)
    profiles = identifiers.to_h do |id|
      path = ENV["sigh_#{id}_adhoc_profile-path"]
      UI.user_error!("#{id} Ad Hoc 프로파일 없음 — regen_profile profile_type:adhoc 필요") unless path && File.exist?(path)
      [id, path]
    end
    identity = ENV["sigh_#{app_id}_adhoc_certificate-name"]
    UI.user_error!('Ad Hoc 서명 인증서가 없습니다') if identity.to_s.empty?
    output = File.join(build_path, 'ios', 'firebase-output')
    FileUtils.mkdir_p(output)
    ipa = File.join(output, "#{release_artifact_stem(slug)}-adhoc.ipa")
    FileUtils.cp(source, ipa)
    resign(ipa: ipa, signing_identity: identity, provisioning_profile: profiles, use_app_entitlements: true)

    params = {
      app: firebase_id,
      ipa_path: ipa,
      groups: options[:groups] || ENV['FIREBASE_TESTER_GROUPS'] || 'aipia_internal',
      release_notes: options[:notes] || "#{slug} #{cfg.dig('version', 'name')} (#{cfg.dig('version', 'code')})"
    }
    creds = ENV['FIREBASE_SERVICE_CREDENTIALS_FILE'] || ENV['GOOGLE_APPLICATION_CREDENTIALS']
    if creds && !creds.strip.empty?
      params[:service_credentials_file] = File.expand_path(creds, REPO_ROOT)
      UI.user_error!('Firebase 인증 파일이 없습니다') unless File.exist?(params[:service_credentials_file])
    elsif !File.exist?(File.expand_path('~/.config/gcloud/application_default_credentials.json'))
      UI.user_error!('Firebase 인증 필요 — CI WIF 또는 로컬 gcloud ADC를 준비하세요')
    end
    firebase_app_distribution(**params)
    UI.success("iOS Firebase 업로드 완료: #{slug}. Ad Hoc 프로파일에 포함된 기기만 설치할 수 있습니다.")
  end

  # appstore 프로비저닝 프로파일을 재생성한다. CI 의 match 는 readonly 라 스스로 못 고치므로,
  # 이 lane 을 로컬에서 1회 돌린 뒤 CI(release)를 iOS 로 재실행한다. 쓰는 상황은 셋:
  #   1) App ID 에서 capability(딥링크=Associated Domains / 푸시 / Apple 로그인 등)를 켠 뒤
  #   2) 새 앱·알림 확장의 프로파일을 처음 만들 때
  #   3) **배포 인증서가 만료돼 새로 발급해야 할 때** (아래 renew_expired_certs 주석 참고)
  #   /opt/homebrew/bin/fastlane ios regen_profile slug:<slug>
  # (기본 rbenv fastlane 은 시스템 Ruby+LibreSSL → .p8 파싱이 'invalid curve name' 으로 깨짐.
  #  반드시 Homebrew fastlane 절대경로로 실행. ASC 키는 before_all 이 secrets/asc_api_key.p8 로 폴백.)
  desc 'appstore 프로파일 재생성 — capability 변경·인증서 만료 후(readonly off + force). 로컬 전용.'
  lane :regen_profile do |options|
    slug = require_slug(options)
    profile_type = options[:profile_type] || 'appstore'
    UI.user_error!('profile_type은 appstore 또는 adhoc이어야 합니다') unless %w[appstore adhoc].include?(profile_type)
    app_id = app_config(slug)['appId']
    # 알림 확장의 프로파일도 같이 만든다. 확장은 별개 번들 id 라 프로파일도 별개이고,
    # CI 의 match 는 readonly 라 스스로 만들 수 없다 — 여기서 안 만들면 CI 가
    # "프로파일 없음"으로 실패한다.
    #
    # 프로젝트가 이미 생성돼 있고 그 안에 확장이 **없으면** 확장 id 는 건너뛴다.
    # 안 쓰는 App ID 를 만들려다 팀 정책에 막히면 이 lane 전체가 실패하는데, 그건
    # 앱 프로파일 재발급만 필요한 경우까지 못 하게 만든다.
    #
    # 프로젝트가 아직 없으면(generate-app 전) 확장 여부를 알 수 없어 같이 만든다 —
    # 안 쓰는 프로파일 하나가 남는 편이, CI 에서 없어서 멈추는 것보다 낫다.
    build_path = File.join(REPO_ROOT, 'build', slug)
    project_exists = Dir.exist?(build_path)
    include_ext = !project_exists || ios_has_nse?(build_path)

    # 확장을 건너뛰는 경우를 **크게 알린다.** 이걸 안 알리면 사용자는 "프로파일 재생성
    # 완료"만 보고 끝났다고 생각하는데, 정작 확장 프로파일이 없어서 나중에 iOS 빌드가
    # 실패한다 — 그때 여기까지 되짚어 오기 어렵다.
    #
    # 이 상황이 생기는 이유: 확장은 generate-app 이 프로젝트에 넣는다. 알림 확장을
    # 처음 도입한 직후엔 build/<slug> 가 그보다 먼저 만들어진 상태라 확장이 없다.
    if project_exists && !include_ext
      UI.important(
        "build/#{slug} 프로젝트에 알림 확장(#{IOS_NSE_TARGET}) 타깃이 없어 확장 프로파일은 만들지 않습니다.\n" \
        "알림에 캐릭터 프로필 사진을 붙이려면 **프로젝트를 먼저 생성**한 뒤 이 lane 을 다시 실행하세요:\n" \
        "  node scripts/generate-app.mjs --slug #{slug} --platform ios\n" \
        "  /opt/homebrew/bin/fastlane ios regen_profile slug:#{slug}"
      )
    end

    ids = include_ext ? [app_id, ios_ext_app_id(app_id)] : app_id

    # **배포 인증서가 만료된 경우까지 여기서 처리한다.** 이 옵션이 없으면(기본 false)
    # match 는 만료된 인증서를 만나는 순간 프로파일을 만들기도 전에 죽는다:
    #   Your certificate '<ID>.cer' is not valid, please check end date and renew it if necessary
    # 그러면 이 lane 을 정본으로 가리키는 문서 전부가 막다른 길이 된다 — 실제로 2026-09
    # 인증서 만료 때 담당자가 이 lane 을 못 쓰고 raw match 명령을 손으로 조립해야 했다.
    #
    # renew_expired_certs 는 **만료됐을 때만** 동작한다(정상이면 무동작). 하는 일은
    # 만료된 .cer/.p12 를 match 저장소에서 지우고 새 인증서를 발급해 커밋하는 것.
    # 옛 인증서를 애플 포털에서 revoke 하지는 않는다 — 인증서 슬롯이 모자라면 `match nuke`.
    #
    # ⚠️ 인증서는 **팀 전체가 공유한다.** 이 lane 이 인증서를 갈아끼우면 다른 앱의 프로파일도
    #    같이 무효가 되므로, 만료 상황에서는 **앱마다 이 lane 을 한 번씩** 돌려야 한다.
    #    그리고 두 사람이 동시에 돌리면 인증서가 2장으로 갈라져 서명이 깨진다 — 한 사람이
    #    순차로 돌릴 것.
    renew_opts = {}
    if profile_type == 'adhoc'
      # 기존 배포 인증서를 재사용한다. 새 기기를 포함하는 프로파일만 갱신한다.
    elsif Gem::Version.new(Fastlane::VERSION) >= Gem::Version.new(MATCH_RENEW_MIN_VERSION)
      renew_opts[:renew_expired_certs] = true
    else
      # 옛 fastlane 에서는 조용히 넘어가지 않고 **미리 크게 알린다.** 만료 상황이면 어차피
      # 아래 match 가 죽는데, 그때 뜨는 건 인증서 에러뿐이라 "그래서 뭘 하라는 건지"가 없다.
      UI.important(
        "fastlane #{Fastlane::VERSION} 에는 만료 인증서 자동 갱신이 없습니다 " \
        "(renew_expired_certs — #{MATCH_RENEW_MIN_VERSION} 이상 필요).\n" \
        "인증서가 만료된 상태라면 바로 아래에서 이렇게 멈춥니다:\n" \
        "  Your certificate '<ID>.cer' is not valid, please check end date and renew it if necessary\n" \
        "그때는 fastlane 을 올리고 다시 실행하세요:  brew upgrade fastlane"
      )
    end

    match({ type: profile_type, app_identifier: ids, readonly: false, force: true }.merge(renew_opts))
    UI.success("프로파일 재생성 완료: #{Array(ids).join(', ')} — 이제 CI(release)를 iOS 로 재실행하세요.")
  end
end

# ──────────────────────────── Android ────────────────────────────
platform :android do
  desc 'Android 릴리즈 번들(.aab) 빌드. 서명은 환경변수/gradle.properties 로 주입.'
  lane :build do |options|
    slug = require_slug(options)
    gradle(
      project_dir: File.join(build_dir(slug), 'android'),
      task: 'bundle',
      build_type: 'Release'
    )
    stage_android_artifact(slug, 'bundle', 'aab')
  end

  desc 'Play 내부 트랙 업로드 (베타). 프로덕션 승격 아님.'
  lane :beta do |options|
    slug = require_slug(options)
    cfg = app_config(slug)
    build(options) unless options[:skip_build]
    aab = options[:skip_build] ? stage_android_artifact(slug, 'bundle', 'aab') : android_artifact_path(slug, 'aab')
    UI.user_error!("AAB 없음: #{aab} — build 를 먼저 실행하세요") unless File.file?(aab)
    upload_to_play_store(
      package_name: cfg['appId'],
      track: options[:track] || 'internal', # internal | beta. production 금지(수동 게이트)
      aab: aab,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      # 'completed' = 그 트랙의 테스터에게 **바로 출시**. 'draft' 면 콘솔에서 "검토 후 출시"를
      # 매번 눌러야 하고, 안 누르면 업로드는 성공인데 테스터는 못 본다 — 실제로 그것 때문에
      # 안드로이드는 스토어를 안 쓰고 APK 를 URL 로 돌려썼다.
      #
      # ⚠️ 이건 **트랙 안에서만** 즉시 출시다. track 은 internal|beta 로 제한돼 있고
      #    production 은 위에서 막혀 있다 — 일반 사용자에게 나가지 않는다.
      release_status: 'completed'
    )
    UI.success("Play #{options[:track] || 'internal'} 트랙 출시 완료 (#{slug}) — 해당 트랙 테스터에게 바로 보입니다. 프로덕션 승격은 Play Console 에서 직접.")
  end

  desc 'Android 릴리즈 APK 빌드 (Firebase App Distribution 용).'
  lane :build_apk do |options|
    slug = require_slug(options)
    # App Distribution 은 AAB 도 받지만, 그 경로는 Firebase↔Play 연동과 Play 앱 서명 키를
    # 요구한다. 내부 테스터가 링크로 바로 설치하는 게 목적이므로 APK 로 굽는다.
    # 서명은 AAB 와 동일 — generate-app 이 buildTypes.release 에 걸어둔 signingConfig 가
    # assembleRelease 에도 그대로 적용된다.
    gradle(
      project_dir: File.join(build_dir(slug), 'android'),
      task: 'assemble',
      build_type: 'Release'
    )
    stage_android_artifact(slug, 'apk', 'apk')
  end

  desc 'Firebase App Distribution 업로드 (내부 테스터에게 즉시 배포). 스토어 공개 아님.'
  lane :firebase do |options|
    # 7분짜리 APK 빌드를 다 돌린 뒤 "액션 없음"으로 죽지 않게, 맨 앞에서 확인한다.
    require_firebase_plugin!
    slug = require_slug(options)
    app_id = firebase_android_app_id(slug)
    build_apk(options) unless options[:skip_build]

    apk = options[:skip_build] ? stage_android_artifact(slug, 'apk', 'apk') : android_artifact_path(slug, 'apk')
    UI.user_error!("APK 없음: #{apk} — build_apk 를 먼저 실행하세요") unless File.file?(apk)

    # 테스터 그룹은 **Firebase 콘솔에서 사람이 미리 만든 별칭(alias)** 이다. 없는 별칭을 주면
    # 업로드는 되는데 아무에게도 안 가므로, 기본값을 두되 그 값을 로그에 남긴다.
    groups = options[:groups] || ENV['FIREBASE_TESTER_GROUPS'] || 'aipia_internal'

    # 자격증명 — **서비스 계정 키(.json)는 쓰지 않는다.** aipia 조직은 org policy
    # `iam.disableServiceAccountKeyCreation` 으로 키 발급 자체를 막아뒀다. 대신:
    #   · CI   — GitHub OIDC(WIF). release.yml 이 external_account 파일 경로를 넘긴다.
    #   · 로컬 — gcloud Application Default Credentials.
    # 플러그인 1.0.0+ 는 파일의 `type` 을 보고 external_account / service_account 를 알아서
    # 가른다. 그래서 WIF 파일을 그대로 service_credentials_file 로 넘기면 된다.
    creds = ENV['FIREBASE_SERVICE_CREDENTIALS_FILE'] || ENV['GOOGLE_APPLICATION_CREDENTIALS']
    creds = File.expand_path(creds, REPO_ROOT) unless creds.nil? || creds.strip.empty?

    cfg = app_config(slug)
    notes = options[:notes] ||
            "#{slug} #{cfg.dig('version', 'name')} (#{cfg.dig('version', 'code')})"

    params = {
      app: app_id,
      android_artifact_type: 'APK',
      android_artifact_path: apk,
      groups: groups,
      release_notes: notes
    }

    if creds && File.exist?(creds)
      params[:service_credentials_file] = creds
      UI.message("자격증명: #{creds}")
    else
      # 파일이 없으면 플러그인이 ADC 로 폴백한다. ADC 도 없으면 플러그인 에러 메시지가
      # 맥락 없이 뜨므로, 여기서 먼저 조치를 안내하고 끊는다.
      adc = File.expand_path('~/.config/gcloud/application_default_credentials.json')
      unless File.exist?(adc)
        UI.user_error!(
          "Firebase 자격증명이 없습니다.\n" \
          "  · CI  — GitHub OIDC(WIF) 로 자동 주입됩니다. 레포 변수 FIREBASE_WIF_PROVIDER_<SLUG> /\n" \
          "          FIREBASE_WIF_SERVICE_ACCOUNT_<SLUG> 설정을 확인하세요 (docs/08-DEPLOY.md §10)\n" \
          "  · 로컬 — gcloud auth application-default login --project=<firebase 프로젝트 id>"
        )
      end
      UI.message('자격증명: gcloud Application Default Credentials')
    end

    UI.message("Firebase App Distribution → app=#{app_id} groups=#{groups}")
    firebase_app_distribution(**params)
    UI.success("Firebase App Distribution 업로드 완료 (#{slug} → #{groups}). 테스터는 초대 메일/링크로 즉시 설치 가능.")
  end
end
