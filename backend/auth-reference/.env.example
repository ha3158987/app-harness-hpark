# 하네스 인증 백엔드 레퍼런스 — 환경변수. 복사: cp .env.example .env
# secret 은 절대 커밋하지 않는다(.gitignore 에 .env 포함).

PORT=8787

# 중앙 IdP(Keycloak) — issuer 는 realm 까지. 로컬: http://localhost:8080/realms/aipia
IDP_ISSUER=https://auth.aipia.co.kr/realms/aipia

# 백엔드 코드교환용 confidential client (Keycloak 에서 별도 생성, Client authentication=ON)
IDP_CLIENT_ID=aipia-app-backend
IDP_CLIENT_SECRET=__set_me__

# 세션쿠키 서명키(길고 랜덤하게) + 쿠키 도메인
SESSION_SECRET=__long_random__
COOKIE_DOMAIN=.aipia.co.kr
COOKIE_SECURE=true
