{
  "slug": "characterchat-dev",
  "appName": "캐릭터챗 DEV",
  "appId": "com.aipia.characterchat.dev",
  "startUrl": "https://chat.dev.poptale.ai",
  "version": {
    "name": "1.0.0",
    "code": 11
  },
  "theme": {
    "primary": "#000000",
    "statusBarStyle": "light",
    "background": "#000000",
    "splashBackground": "#2A307A",
    "splashDuration": 2500
  },
  "features": {
    "push": true,
    "deepLink": true,
    "biometric": true,
    "share": true,
    "camera": true,
    "forceUpdate": false,
    "secureStorage": true,
    "localNotification": true,
    "haptics": true,
    "clipboard": true,
    "geolocation": true,
    "darkMode": true
  },
  "navigation": {
    "allowedDomains": [
      "chat.dev.poptale.ai",
      "*.poptale.ai"
    ],
    "externalInBrowser": true
  },
  "marketing": {
    "attribution": {
      "provider": "adbrix",
      "deferredDeepLink": true
    },
    "analytics": {
      "provider": null
    },
    "autoCapture": false
  },
  "tracking": {
    "att": {
      "enabled": true,
      "usageDescription": "관심에 더 맞는 광고를 제공하고 마케팅 성과를 측정하기 위해 활동 데이터를 사용합니다.",
      "prePermission": true
    }
  },
  "legal": {
    "privacyUrl": "https://poptale.ai/info/privacy",
    "termsUrl": "https://poptale.ai/info/terms"
  },
  "permissions": {},
  "auth": {
    "deviceEndpoint": "https://api.chat.dev.poptale.ai/api/push/register"
  },
  "firebase": {
    "enabled": true,
    "project": {
      "dev": "poptale-chat"
    },
    "fcm": true
  },
  "ios": {
    "teamId": "3W889GYPRK"
  },
  "android": {
    "sha256CertFingerprints": []
  }
}
