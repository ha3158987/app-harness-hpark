{
  "slug": "aipia",
  "appName": "AIPIA",
  "appId": "kr.co.aipia.app",
  "startUrl": "https://aipia.co.kr",
  "version": { "name": "1.0.0", "code": 1 },
  "theme": {
    "primary": "#1A73E8",
    "statusBarStyle": "light",
    "background": "#FFFFFF"
  },
  "assets": { "icon": "icon.png", "splash": "splash.png" },
  "features": {
    "push": true,
    "deepLink": true,
    "deferredDeepLink": { "enabled": true, "provider": "appsflyer" },
    "biometric": true,
    "share": true,
    "camera": true,
    "forceUpdate": { "enabled": true, "minVersionUrl": "https://aipia.co.kr/min-version.json" },
    "secureStorage": true,
    "localNotification": true,
    "haptics": true,
    "clipboard": true,
    "geolocation": true
  },
  "navigation": {
    "allowedDomains": ["aipia.co.kr", "*.aipia.co.kr"],
    "externalInBrowser": true
  },
  "marketing": {
    "attribution": { "provider": "appsflyer", "deferredDeepLink": true },
    "analytics": { "provider": null },
    "crm": { "provider": null }
  },
  "auth": {
    "providers": ["email", "apple", "google", "naver", "kakao", "facebook", "x", "threads"],
    "sessionEndpoint": "https://aipia.co.kr/auth/native",
    "signupEndpoint": "https://aipia.co.kr/auth/signup",
    "logoutEndpoint": "https://aipia.co.kr/auth/logout",
    "idp": {
      "issuer": "https://auth.aipia.co.kr/realms/aipia",
      "clientId": "aipia-app",
      "hintParam": "kc_idp_hint",
      "hints": {
        "google": "google", "kakao": "kakao", "naver": "naver", "apple": "apple",
        "facebook": "facebook", "x": "twitter", "threads": "threads"
      }
    }
  },
  "iap": {
    "verifyEndpoint": "https://aipia.co.kr/iap/verify",
    "products": [
      { "id": "coin_100", "storeId": "kr.co.aipia.app.coin100", "type": "consumable" },
      { "id": "coin_500", "storeId": "kr.co.aipia.app.coin500", "type": "consumable" }
    ]
  }
}
