{
  "slug": "characterchat",
  "appName": "캐릭터챗",
  "appId": "com.aipia.characterchat",
  "startUrl": "https://chat.poptale.ai",
  "version": {
    "name": "1.0.0",
    "code": 1
  },
  "theme": {
    "primary": "#000000",
    "statusBarStyle": "light",
    "background": "#000000",
    "splashBackground": "#2A307A",
    "splashDuration": 2500
  },
  "features": {
    "push": false,
    "deepLink": true,
    "biometric": false,
    "share": true,
    "camera": false,
    "forceUpdate": false,
    "secureStorage": true,
    "localNotification": false,
    "haptics": true,
    "clipboard": false,
    "geolocation": false,
    "darkMode": true
  },
  "navigation": {
    "allowedDomains": [
      "chat.poptale.ai",
      "*.poptale.ai"
    ],
    "externalInBrowser": true
  },
  "marketing": {
    "attribution": {
      "provider": null
    },
    "analytics": {
      "provider": null
    },
    "autoCapture": false
  },
  "tracking": {
    "att": {
      "enabled": false,
      "usageDescription": "관심에 더 맞는 광고를 제공하고 마케팅 성과를 측정하기 위해 활동 데이터를 사용합니다.",
      "prePermission": true
    }
  },
  "legal": {
    "privacyUrl": "https://poptale.ai/info/privacy",
    "termsUrl": "https://poptale.ai/info/terms"
  },
  "permissions": {},
  "auth": {
    "providers": ["email", "kakao", "naver", "line", "google", "apple", "facebook", "x", "discord"],
    "sessionEndpoint": "https://api.chat.poptale.ai/auth/social/native",
    "signupEndpoint": "https://api.chat.poptale.ai/auth/signup",
    "logoutEndpoint": "https://api.chat.poptale.ai/auth/logout",
    "deleteEndpoint": "https://api.chat.poptale.ai/auth/withdraw",
    "deviceEndpoint": "https://api.chat.poptale.ai/api/push/register",
    "oauth": {
      "kakao":    { "clientId": null },
      "naver":    { "clientId": null },
      "line":     { "clientId": null },
      "google":   { "clientId": null },
      "apple":    { "clientId": null },
      "facebook": { "clientId": null },
      "x":        { "clientId": null },
      "discord":  { "clientId": null }
    }
  },
  "ios": {
    "teamId": "3W889GYPRK"
  },
  "android": {
    "sha256CertFingerprints": []
  }
}
